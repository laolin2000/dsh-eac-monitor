{
  "name": "dsh-eac-monitor",
  "version": "0.1.0",
  "description": "EAC 悬浮监控窗:Token 用量/余额(DeepSeek API + Edge CDP)与存储空间(会话/工作区/EAC 目录)实时监控",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "index.js",
    "client.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.18"
  },
  "license": "MIT"
}
